# Source and document files stay LF so Git does not rewrite code and generated
# public text on Windows. Evidence rules below deliberately override this.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.csv     text eol=lf
*.html    text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.jsonl   text eol=lf
*.md      text eol=lf
*.ps1     text eol=lf
*.py      text eol=lf
*.svg     text eol=lf
*.txt     text eol=lf
*.xml     text eol=lf

# Evidence is stored so that its sha256 can be checked against the manifest.
# Git's line-ending normalisation would defeat that: a file committed with LF
# and checked out on Windows as CRLF is no longer the bytes that were served,
# and every hash in every MANIFEST.json would fail for anyone who cloned the
# repository on a different platform. Evidence is therefore binary to git.
research/evidence/**   -text -diff
research/observations/**  -text
# Recovery receipts are hashed byte-for-byte, including original log newlines.
research/_trail/repair-20260911/followthrough/** -text
# These dated audits/recoveries carry SHA-256 manifests of the original bytes.
# Preserve their transcripts across platforms just like other evidence.
research/_trail/COMPREHENSIVE_AUDIT_2026-09-14.md -text
research/_trail/comprehensive-audit-20260914/** -text
research/_trail/remediation-plan-20260914/** -text
research/_trail/remediation-20260914/** -text
research/_trail/permissions-20260914/** -text
research/_trail/r02-20260914/** -text
research/_trail/r04-20260914/** -text
research/_trail/r05-20260914/** -text
*.gz      binary
*.xls     binary
*.xlsx    binary
*.zip     binary
*.gpkg    binary
*.pdf     binary
data/ca-bundle-windows.pem  -text
public/dataset/**  -text
